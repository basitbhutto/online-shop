@model Presentation.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "_AuthLayout";
    var returnUrl = ViewData["ReturnUrl"] as string ?? Context.Request.Query["returnUrl"].ToString() ?? "";
}

<div class="sv-auth-page">
    <aside class="sv-auth-aside">
        <div class="sv-brand sv-brand-dark mb-1">
            <img src="~/images/logo-icon.svg" alt="" class="sv-logo-icon" />
            <span class="sv-wordmark sv-wordmark-on-dark">Shop<span>Vibe</span></span>
        </div>
        <h2>Join ShopVibe</h2>
        <p class="mb-0">Create an account for faster checkout, order tracking, and saved favorites.</p>
    </aside>
    <div class="d-flex align-items-center justify-content-center p-4">
        <div class="sv-auth-card">
            <div class="mb-4">
                <h1 class="h3 fw-bold mb-1">Create your account</h1>
                <p class="text-muted small mb-0">All fields marked with <span class="sv-required">*</span> are required.</p>
            </div>
            <form asp-controller="Account" asp-action="Register" method="post" id="registerForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="FullName" class="sv-label">Full name <span class="sv-required">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-person"></i>
                        <input asp-for="FullName" class="form-control" placeholder="Ali Hassan" autocomplete="name" />
                    </div>
                    <span asp-validation-for="FullName" class="field-validation-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="sv-label">Email address <span class="sv-required">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="sv-label">Password <span class="sv-required">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password" class="form-control" placeholder="At least 8 characters" autocomplete="new-password" />
                        <button type="button" class="sv-toggle-password" aria-label="Show password"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="sv-label">Confirm password <span class="sv-required">*</span></label>
                    <div class="input-icon-wrap">
                        <i class="bi bi-shield-lock"></i>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="agreeTerms" name="agreeTerms" required />
                    <label class="form-check-label small" for="agreeTerms">I agree to the Terms &amp; Privacy Policy <span class="sv-required">*</span></label>
                </div>
                <button type="submit" class="btn btn-sv w-100" data-loading-text="Creating account...">Create account</button>
            </form>
            <p class="text-center mt-4 mb-0 small">Already have an account? <a asp-action="Login" class="fw-semibold">Sign in</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

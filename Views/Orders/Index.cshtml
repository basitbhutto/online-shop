@model IEnumerable<Domain.Entities.Order>
@using Presentation.Helpers
@using Domain.Enums
@{
    ViewData["Title"] = "My Orders";
    var orders = Model?.ToList() ?? new List<Domain.Entities.Order>();
}
<div class="container py-4">
    <div class="sv-page-header"><div><div class="sv-page-kicker">Account</div><h1 class="mb-0">My orders</h1></div></div>
    @if (!orders.Any())
    {
        <div class="sv-empty sv-card">
            <i class="bi bi-bag"></i>
            <h3>No orders yet</h3>
            <p>Orders will appear here after you checkout.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-sv">Start shopping</a>
        </div>
    }
    else
    {
        <div class="sv-card">
            <div class="sv-table-wrap">
                <table class="table sv-table mb-0">
                    <thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var order in orders)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge @(order.Status == OrderStatus.Delivered || order.Status == OrderStatus.Completed ? "bg-success" : order.Status == OrderStatus.Cancelled ? "bg-danger" : "bg-secondary")">@OrderStatusHelper.DisplayName(order.Status)</span></td>
                            <td>Rs @order.TotalAmount.ToString("N0")</td>
                            <td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-sv">View</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

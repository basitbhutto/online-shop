@model Presentation.ViewModels.Checkout.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}
<div class="container py-4">
    <div class="sv-page-header"><div><div class="sv-page-kicker">ShopVibe</div><h1 class="mb-0">Checkout</h1></div></div>
    <form asp-action="PlaceOrder" method="post" novalidate>
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="sv-form-section">
                    <h3>Shipping details</h3>
                    <div class="mb-3">
                        <label asp-for="ShippingAddress" class="sv-label">Shipping address <span class="sv-required">*</span></label>
                        <textarea asp-for="ShippingAddress" class="form-control" rows="3" placeholder="House, street, area"></textarea>
                        <span asp-validation-for="ShippingAddress" class="field-validation-error"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="sv-label">Phone number <span class="sv-required">*</span></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="03XX-XXXXXXX" />
                        <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PreferredDeliveryTime" class="sv-label">Preferred delivery time <span class="sv-optional">Optional</span></label>
                        <select asp-for="PreferredDeliveryTime" class="form-select">
                            <option value="">Any time</option>
                            <option value="Morning 9 AM - 12 PM">Morning 9 AM - 12 PM</option>
                            <option value="Afternoon 12 PM - 5 PM">Afternoon 12 PM - 5 PM</option>
                            <option value="Evening 5 PM - 9 PM">Evening 5 PM - 9 PM</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label asp-for="City" class="sv-label">City <span class="sv-required">*</span></label>
                        <input asp-for="City" class="form-control" readonly value="Karachi" />
                        <p class="sv-form-hint">We currently deliver only to Karachi.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="sv-form-section">
                    <h3>Payment</h3>
                    <p class="mb-0"><i class="bi bi-cash-stack me-2"></i>Cash on delivery</p>
                </div>
                <div class="sv-form-section">
                    <h3>Order summary</h3>
                    <ul class="list-unstyled mb-3">
                        @foreach (var item in Model.CartItems)
                        {
                            <li class="d-flex justify-content-between mb-2">
                                <span>@item.ProductName × @item.Quantity</span>
                                <span>Rs @((item.Quantity * item.Price).ToString("N0"))</span>
                            </li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between fw-bold mb-3">
                        <span>Total</span>
                        <span>Rs @Model.TotalAmount.ToString("N0")</span>
                    </div>
                    <button type="submit" class="btn btn-sv w-100" data-loading-text="Placing order...">Place order</button>
                </div>
            </div>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

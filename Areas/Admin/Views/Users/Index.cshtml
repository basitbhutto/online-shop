@model List<Presentation.Areas.Admin.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "Users";
    var total = ViewBag.Total as int? ?? 0;
    var page = ViewBag.Page as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 20;
    var search = ViewBag.Search as string ?? "";
}
<div class="sv-page-header">
    <div>
        <div class="sv-page-kicker">People</div>
        <h1 class="mb-0">Users</h1>
    </div>
</div>
<form method="get" class="mb-3" style="max-width:420px">
    <div class="input-group">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search by email, name..." />
        <button type="submit" class="btn btn-sv-navy"><i class="bi bi-search"></i></button>
    </div>
</form>
<div class="sv-card">
    @if (Model.Any())
    {
        <div class="sv-table-wrap">
            <table class="table sv-table mb-0">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Full name</th>
                        <th>Roles</th>
                        <th>Verified</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.Email</td>
                            <td>@u.FullName</td>
                            <td><span class="badge bg-primary">@u.Roles</span></td>
                            <td>@(u.EmailConfirmed ? "Verified" : "Pending")</td>
                            <td>@u.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td><a asp-action="EditRoles" asp-route-id="@u.Id" class="btn btn-sm btn-outline-sv">Edit roles</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (total > pageSize)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="text-muted small">Showing @((page-1)*pageSize + 1)–@Math.Min(page*pageSize, total) of @total</span>
                <div class="d-flex gap-2">
                    @if (page > 1)
                    {
                        <a href="?page=@(page-1)&pageSize=@pageSize&search=@Uri.EscapeDataString(search)" class="btn btn-sm btn-outline-sv">Previous</a>
                    }
                    @if (page * pageSize < total)
                    {
                        <a href="?page=@(page+1)&pageSize=@pageSize&search=@Uri.EscapeDataString(search)" class="btn btn-sm btn-outline-sv">Next</a>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="sv-empty">
            <i class="bi bi-people"></i>
            <h3>No users found</h3>
            <p>Try a different search, or wait for customers to register.</p>
        </div>
    }
</div>

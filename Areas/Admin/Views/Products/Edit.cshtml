@model Presentation.Areas.Admin.ViewModels.ProductEditViewModel
@{
    ViewData["Title"] = "Edit Product";
}
<div class="mb-3"><a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Back to Products</a></div>
<div class="sv-page-header">
    <div>
        <div class="sv-page-kicker">Catalog</div>
        <h1 class="mb-0">Edit Product</h1>
        <p class="text-muted small mb-0">Fields marked <span class="sv-required">*</span> are required.</p>
    </div>
</div>
<form asp-action="Edit" method="post" enctype="multipart/form-data" id="productForm" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="sv-form-section">
        <h3><i class="bi bi-info-circle"></i> Basic information</h3>
        <div class="row g-3">
            <div class="col-12">
                <label class="sv-label" asp-for="Name">Product name <span class="sv-required">*</span></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label class="sv-label" asp-for="SKU">SKU <span class="sv-required">*</span></label>
                <input asp-for="SKU" class="form-control" />
                <span asp-validation-for="SKU" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label class="sv-label" asp-for="CategoryId">Category <span class="sv-required">*</span></label>
                <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))"></select>
                <span asp-validation-for="CategoryId" class="field-validation-error"></span>
            </div>
            <div class="col-12 position-relative">
                <label class="sv-label">Location <span class="sv-optional">Optional</span></label>
                <input type="hidden" asp-for="LocationId" id="locationId" />
                <input type="text" id="locationSearch" class="form-control" placeholder="Search location..." autocomplete="off" />
                <div id="locationDropdown" class="list-group position-absolute start-0 shadow-sm w-100" style="display:none; max-height:220px; overflow-y:auto; z-index:1000;"></div>
            </div>
            <div class="col-12">
                <label class="sv-label" asp-for="Description">Description <span class="sv-optional">Optional</span></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>
        </div>
    </div>
    <div class="sv-form-section">
        <h3><i class="bi bi-tag"></i> Pricing</h3>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="sv-label" asp-for="PurchasePrice">Purchase price (Rs) <span class="sv-optional">Optional</span></label>
                <input asp-for="PurchasePrice" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="sv-label" asp-for="SalePrice">Sale price (Rs) <span class="sv-required">*</span></label>
                <input asp-for="SalePrice" type="number" step="0.01" min="0" class="form-control" />
                <span asp-validation-for="SalePrice" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label class="sv-label" asp-for="DiscountPrice">Discount price (Rs) <span class="sv-optional">Optional</span></label>
                <input asp-for="DiscountPrice" type="number" step="0.01" min="0" class="form-control" />
            </div>
        </div>
    </div>
    <div class="sv-form-section">
        <h3><i class="bi bi-boxes"></i> Inventory</h3>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="sv-label" asp-for="Stock">Stock <span class="sv-required">*</span></label>
                <input asp-for="Stock" type="number" min="0" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="sv-label" asp-for="Status">Availability <span class="sv-required">*</span></label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>
        </div>
    </div>
    <div class="sv-form-section">
        <h3><i class="bi bi-images"></i> Images</h3>
        @if (Model.ImageUrls?.Any() == true)
        {
            <p class="sv-form-hint">Current images. Click × to remove, then save.</p>
            <div class="sv-upload-preview mb-3" id="existingImages">
                @foreach (var url in Model.ImageUrls)
                {
                    <div class="sv-upload-thumb">
                        <img src="@url" alt="" onerror="this.src='/images/placeholder.svg'" />
                        <button type="button" class="js-remove-existing-image" aria-label="Remove image">&times;</button>
                        <input type="hidden" name="ImageUrls" value="@url" />
                    </div>
                }
            </div>
        }
        <div class="row g-3">
            <div class="col-md-6">
                <label class="sv-label">Replace cover <span class="sv-optional">Optional</span></label>
                <div class="sv-upload">
                    <input type="file" name="CoverImage" id="coverImage" accept="image/*" class="form-control" />
                    <div class="sv-upload-preview" id="coverPreview"></div>
                </div>
            </div>
            <div class="col-md-6">
                <label class="sv-label">Add gallery images <span class="sv-optional">Optional</span></label>
                <div class="sv-upload">
                    <input type="file" name="GalleryImages" id="galleryImages" accept="image/*" multiple class="form-control" />
                    <div class="sv-upload-preview" id="galleryPreview"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="sv-form-section">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0"><i class="bi bi-sliders"></i> Specifications <span class="sv-optional">Optional</span></h3>
            <button type="button" class="btn btn-outline-sv btn-sm" id="addSpec"><i class="bi bi-plus-lg me-1"></i>Add attribute</button>
        </div>
        <div id="specContainer">
            @if (Model.Specifications?.Any() == true)
            {
                @for (var i = 0; i < Model.Specifications.Count; i++)
                {
                    <div class="row g-2 spec-row mb-2">
                        <div class="col-5"><input type="text" name="Specifications[@i].Key" class="form-control" value="@Model.Specifications[i].Key" placeholder="Attribute" /></div>
                        <div class="col-5"><input type="text" name="Specifications[@i].Value" class="form-control" value="@Model.Specifications[i].Value" placeholder="Value" /></div>
                        <div class="col-2"><button type="button" class="btn btn-outline-danger w-100 remove-spec"><i class="bi bi-trash"></i></button></div>
                    </div>
                }
            }
            else
            {
                <div class="row g-2 spec-row mb-2">
                    <div class="col-5"><input type="text" name="Specifications[0].Key" class="form-control" placeholder="Attribute (e.g. Color)" /></div>
                    <div class="col-5"><input type="text" name="Specifications[0].Value" class="form-control" placeholder="Value (e.g. Navy)" /></div>
                    <div class="col-2"><button type="button" class="btn btn-outline-danger w-100 remove-spec"><i class="bi bi-trash"></i></button></div>
                </div>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-sv" data-loading-text="Saving...">Save changes</button>
        <a asp-action="Index" class="btn btn-outline-sv">Cancel</a>
    </div>
</form>

@section Scripts {
<partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
<script>
(function() {
    var container = document.getElementById('specContainer');
    var idx = container.querySelectorAll('.spec-row').length;
    document.getElementById('addSpec').addEventListener('click', function() {
        var tpl = container.querySelector('.spec-row').cloneNode(true);
        tpl.querySelector('[name*="Key"]').name = 'Specifications[' + idx + '].Key';
        tpl.querySelector('[name*="Key"]').value = '';
        tpl.querySelector('[name*="Value"]').name = 'Specifications[' + idx + '].Value';
        tpl.querySelector('[name*="Value"]').value = '';
        container.appendChild(tpl);
        idx++;
    });
    container.addEventListener('click', function(e) {
        if (e.target.closest('.remove-spec')) e.target.closest('.spec-row')?.remove();
    });
    document.getElementById('existingImages')?.addEventListener('click', function(e) {
        var btn = e.target.closest('.js-remove-existing-image');
        if (btn) btn.closest('.sv-upload-thumb')?.remove();
    });
    document.getElementById('coverImage').addEventListener('change', function() {
        if (window.ShopVibe) ShopVibe.previewImages(this, 'coverPreview');
    });
    document.getElementById('galleryImages').addEventListener('change', function() {
        if (window.ShopVibe) ShopVibe.previewImages(this, 'galleryPreview');
    });
    var locationIdEl = document.getElementById('locationId');
    var locationSearchEl = document.getElementById('locationSearch');
    var locationDropdownEl = document.getElementById('locationDropdown');
    locationSearchEl.addEventListener('input', function() {
        if (!this.value.trim()) { locationIdEl.value = ''; locationDropdownEl.style.display = 'none'; return; }
        clearTimeout(locationSearchEl._debounce);
        locationSearchEl._debounce = setTimeout(function() {
            fetch('/Admin/api/LocationsApi/search?q=' + encodeURIComponent(locationSearchEl.value.trim()))
                .then(function(r) { return r.json(); })
                .then(function(items) {
                    locationDropdownEl.innerHTML = '';
                    if (!items || !items.length) { locationDropdownEl.style.display = 'none'; return; }
                    items.forEach(function(o) {
                        var a = document.createElement('a');
                        a.href = '#';
                        a.className = 'list-group-item list-group-item-action';
                        a.textContent = o.fullPath || o.name;
                        a.addEventListener('click', function(e) {
                            e.preventDefault();
                            locationIdEl.value = o.id;
                            locationSearchEl.value = o.fullPath || o.name;
                            locationDropdownEl.style.display = 'none';
                        });
                        locationDropdownEl.appendChild(a);
                    });
                    locationDropdownEl.style.display = 'block';
                });
        }, 200);
    });
    locationSearchEl.addEventListener('blur', function() { setTimeout(function() { locationDropdownEl.style.display = 'none'; }, 150); });
})();
</script>
}

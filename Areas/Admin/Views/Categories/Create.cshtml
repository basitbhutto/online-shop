@model Presentation.Areas.Admin.ViewModels.CategoryCreateViewModel
@{
    ViewData["Title"] = "Create Category";
}
<div class="mb-3"><a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Back to Categories</a></div>
<div class="sv-page-header"><div><div class="sv-page-kicker">Catalog</div><h1 class="mb-0">Create Category</h1></div></div>
<form asp-action="Create" method="post" enctype="multipart/form-data" novalidate style="max-width:560px">
    @Html.AntiForgeryToken()
    <div class="sv-form-section">
        <div class="mb-3">
            <label asp-for="Name" class="sv-label">Name <span class="sv-required">*</span></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Electronics" />
            <span asp-validation-for="Name" class="field-validation-error"></span>
        </div>
        <div class="mb-3">
            <label class="sv-label">Category image <span class="sv-optional">Optional</span></label>
            <input type="file" name="Image" accept="image/*" class="form-control" />
            <p class="sv-form-hint">JPG, PNG, GIF or WebP. Recommended 400×400px.</p>
        </div>
        <div class="mb-0">
            <label asp-for="ParentId" class="sv-label">Parent category <span class="sv-optional">Optional</span></label>
            <select asp-for="ParentId" class="form-select">
                <option value="">None (root category)</option>
                @foreach (var p in Model.ParentOptions)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-sv">Create category</button>
        <a asp-action="Index" class="btn btn-outline-sv">Cancel</a>
    </div>
</form>

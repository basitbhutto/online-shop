@model List<Presentation.Areas.Admin.ViewModels.CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
}
<div class="sv-page-header">
    <div>
        <div class="sv-page-kicker">Catalog</div>
        <h1 class="mb-0">Categories</h1>
    </div>
    <a asp-action="Create" class="btn btn-sv"><i class="bi bi-plus-lg me-1"></i>Add category</a>
</div>
<div class="sv-card">
    @if (Model.Any())
    {
        <div class="sv-table-wrap">
            <table class="table sv-table mb-0">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Slug</th>
                        <th>Parent</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(c.ImageUrl))
                                {
                                    <img src="@c.ImageUrl" alt="@c.Name" class="rounded" style="height:48px;width:48px;object-fit:cover" onerror="this.src='/images/placeholder.svg'" />
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:48px;width:48px"><i class="bi bi-image text-muted"></i></div>
                                }
                            </td>
                            <td><strong>@c.Name</strong></td>
                            <td><code>@c.Slug</code></td>
                            <td>@(c.ParentName ?? "—")</td>
                            <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                            <td>@c.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-sv">Edit</a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-sv-confirm="1" data-sv-title="Delete category?" data-sv-text="This action cannot be undone." data-sv-ok="Delete">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="sv-empty">
            <i class="bi bi-folder"></i>
            <h3>No categories yet</h3>
            <p>Create a category before adding products.</p>
            <a asp-action="Create" class="btn btn-sv">Add category</a>
        </div>
    }
</div>

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @ShopVibeBrand.AdminName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="sv-admin-body" data-sv-success="@TempData["Success"]" data-sv-error="@TempData["Error"]">
    <div class="sv-admin-topbar">
        <button type="button" class="btn btn-ghost text-white" data-sv-sidebar-toggle aria-label="Open menu"><i class="bi bi-list fs-4"></i></button>
        <strong>@ShopVibeBrand.AdminName</strong>
        <span></span>
    </div>
    <div class="sv-sidebar-backdrop"></div>
    <div class="sv-admin">
        <aside class="sv-sidebar">
            <a class="sv-sidebar-brand" href="/">
                <img src="~/images/logo-icon.svg" alt="" class="sv-logo-icon" />
                <span class="sv-wordmark sv-wordmark-on-dark">Shop<span>Vibe</span></span>
                <span class="sv-sidebar-admin-label">Admin</span>
            </a>
            <nav class="sv-sidebar-nav">
                <a class="nav-link @(controller == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid"></i>Dashboard</a>
                <a class="nav-link @(controller == "Orders" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="bi bi-bag-check"></i>Orders</a>
                <a class="nav-link @(controller == "Products" ? "active" : "")" asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i>Products</a>
                <a class="nav-link @(controller == "Categories" ? "active" : "")" asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-folder"></i>Categories</a>
                <a class="nav-link @(controller == "Users" ? "active" : "")" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i>Users</a>
                <a class="nav-link @(controller == "ProductChat" ? "active" : "")" asp-area="Admin" asp-controller="ProductChat" asp-action="Index"><i class="bi bi-chat-dots"></i>Product Chats</a>
                <a class="nav-link" href="/"><i class="bi bi-shop"></i>View Store</a>
            </nav>
            <div class="sv-sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" id="adminLogoutForm">
                    <button type="submit" class="nav-link w-100 border-0 bg-transparent" data-sv-logout="adminLogoutForm"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                </form>
            </div>
        </aside>
        <div class="sv-admin-main">
            @RenderBody()
        </div>
    </div>
    <partial name="/Views/Shared/_ToastContainer.cshtml" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/shopvibe.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
